# Example Environment Variables
# Copy this file to .env and replace the placeholder values with your actual keys
# NEVER commit this file with real values to version control

# LLM Provider API Keys
NVIDIA_API_KEY=your_nvidia_api_key_here
OPENROUTER_API_KEY=your_openrouter_api_key_here
MINIMAX_API_KEY=your_minimax_api_key_here
ALIBABA_API_KEY=your_alibaba_api_key_here
OPENAI_API_KEY=your_openai_api_key_here
ANTHROPIC_API_KEY=your_anthropic_api_key_here
GOOGLE_API_KEY=your_google_api_key_here
COHERE_API_KEY=your_cohere_api_key_here

# MCP Server Credentials (these are typically handled via OAuth flows)
# FIGMA_CLIENT_ID=your_figma_client_id
# FIGMA_CLIENT_SECRET=your_figma_client_secret
# HUGGINGFACE_TOKEN=your_huggingface_token

# Database Configuration (if using external database)
# DATABASE_URL=your_database_connection_string
# DATABASE_POOL_SIZE=10

# Memory Configuration
# MEMORY_ROOT=C:/RankBrum/MemoryCore
# MEMORY_CHAR_LIMIT=2200
# USER_CHAR_LIMIT=1375

# Feature Flags
# ENABLE_TELEMETRY=false
# ENABLE_AUTO_UPDATES=true
# ENABLE_SKILL_SUGGESTIONS=true

# Security Settings
# SESSION_TIMEOUT=3600
# MAX_LOGIN_ATTEMPTS=5
# PASSWORD_MIN_LENGTH=12

# API Rate Limits (adjust based on your provider limits)
# OPENROUTER_RPM=60
# NVIDIA_RPM=120

# Custom Application Settings
# APP_NAME=RankBrum Hermes
# APP_VERSION=1.0.0
# DEBUG_MODE=false